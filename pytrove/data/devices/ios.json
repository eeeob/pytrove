{
 "schema": 1,
 "platform": "ios",
 "updated": "2026-10-31",
 "model_format": "MTApiEnvironment.platformString table, keyed by hw.machine",
 "version_format": "[UIDevice currentDevice].systemVersion -- plain, no prefix",
 "sources": [
  "https://api.ipsw.me/v4/device/{identifier}?type=ipsw -- released iOS firmwares per device",
  "https://api.appledb.dev/device/main.json -- iPhone identifiers, release dates",
  "https://raw.githubusercontent.com/TelegramMessenger/Telegram-iOS/master/submodules/MtProtoKit/Sources/MTApiEnvironment.m -- platformString, the exact model string the client sends",
  "https://github.com/TelegramMessenger/Telegram-iOS/blob/master/submodules/TelegramUI/Sources/AppDelegate.swift -- passes deviceModelName: nil, which is why platformString is what reaches the wire"
 ],
 "notes": [
  "model comes from Telegram's own platformString table, not Apple's marketing name: the client hardcodes the string, so a device the table omits reports 'Unknown iPhone' instead.",
  "version is [UIDevice currentDevice].systemVersion verbatim (MTApiEnvironment.m), which carries no 'iOS' prefix."
 ],

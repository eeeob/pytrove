# Environments
.env
.env.test
# `.venv*` rather than `.venv`: `make test-floor` and `make test-ceil` build `.venv-floor`
#  and `.venv-ceil` beside it, and an exact match leaves those untracked and committable.
.venv*
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
# Per-tool download caches under tools/. The bare `.cache` above (left over
# from pytest) already matches these, but it sits under a heading about
# coverage reports, so this states the intent where it will not be pruned by
# mistake. A cache is rebuildable and one of them is 20 MB.
tools/*/.cache/

# Local AI-assistant state: Claude Code's knowledge, plans and settings, and
# Serena's project index. Kept on each developer's machine for now.
.claude/
CLAUDE.md
AGENTS.md
.serena/

# The device catalogs are generated byte-for-byte reproducibly, and the
# generator writes LF on every platform. Without this, core.autocrlf checks
# them out as CRLF on Windows while a rebuild writes LF, so all four files
# show as fully modified with nothing actually changed.
pytrove/data/devices/*.json -text

# The source lock is generated the same way and written with LF too, and its
# whole value is that a diff in it means something upstream moved -- a newline
# conversion showing all 157 lines as changed would destroy exactly that.
tools/*/sources/sources.lock.json -text
